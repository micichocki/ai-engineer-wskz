# Optional overrides. Copy to .env; every value below is the default.

# Tool-calling LLM that sends the e-mail (any Ollama model with the "tools" capability).
AGENT_MODEL=qwen3:1.7b
# System-one decision model that classifies the message.
DECISION_MODEL=d3:2b
# Below this confidence the agent ignores the suggestion and decides itself.
CONFIDENCE_THRESHOLD=0.8

# Host ports.
API_PORT=8000
MAILHOG_PORT=8025
