# Optional overrides. Copy to .env; every value below is the default.

# agent: the LLM decides and calls the send_email tool (what the task asks for).
# decision: the decision model decides and code makes the same tool call (no LLM).
ROUTER_MODE=agent

# Agent mode: tool-calling LLM that sends the e-mail (any Ollama model with the "tools" capability).
AGENT_MODEL=qwen3:1.7b
# Decision mode: system-one decision model that classifies the message.
DECISION_MODEL=d3:2b

# Host ports.
API_PORT=8000
MAILHOG_PORT=8025
